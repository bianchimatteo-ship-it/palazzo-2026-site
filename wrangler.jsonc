// Cloudflare Workers: POLITICANDO 2026 is served as Workers static assets (the same files as GitHub Pages;
// .assetsignore keeps tooling and sources out). worker.js answers only /api/*: the owner's shared archive
// of corrections and logos, kept in Workers KV so that it survives refreshes, restarts and new deploys,
// and the player accounts with their online saves, kept in Cloudflare D1.
{
  "name": "palazzo-2026-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Once a day the Worker drops expired sessions and old rate-limit rows (scheduled() in worker.js), as the privacy text says.
  "triggers": { "crons": ["37 3 * * *"] },
  "preview_urls": false,
  // E-mail of the accounts (verification and recovery of the password): messages leave through a Google Apps Script gateway (sends from the owner's Gmail). EMAIL_GATEWAY_URL is below; the shared
  // secret is NOT in the project: set it as a Worker secret equal to the gateway's SHARED_SECRET (npx wrangler secret put EMAIL_GATEWAY_SECRET). Until it exists nothing is sent and the service says so.
  // RETENTION_ENABLED / RETENTION_NOTICE_TESTED stay "0": the deletion of accounts inactive for 12 months is written but OFF until the notice channel is configured and tested (docs/conservazione-account.md).
  // See docs/account-email.md. PUBLIC_BASE_URL is where the links of the messages lead; ACCOUNT_EMAIL_REQUIRED "1" makes the address mandatory at registration.
  "vars": { "EMAIL_GATEWAY_URL": "https://script.google.com/macros/s/AKfycbwzUfLKTPFmcorBTV6YfT6Z7u9IYaVxOwXmCogAVE5TgfE12NgFsswmWn_vLWi0J1tcNQ/exec", "PUBLIC_BASE_URL": "https://palazzo-2026-site.bianchimatteo657.workers.dev", "ACCOUNT_EMAIL_REQUIRED": "0", "RETENTION_ENABLED": "0", "RETENTION_NOTICE_TESTED": "0" },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "ADMIN_ARCHIVE", "id": "a40ce7a2dc6b4ea6bfa5bedafedc421a" }
  ],
  // Player accounts and online career saves (tables are created by worker.js on first use; see migrations/).
  // Personal party logos of the accounts (images). The bucket is NOT created by this file: create it once with `npx wrangler r2 bucket create politicando-logos` (docs/logo-sync.md).
  // Until it exists the binding makes a deploy fail, so it is declared only after the bucket has been created: see the commented block below and the steps in the documentation.
  // "r2_buckets": [{ "binding": "LOGOS", "bucket_name": "politicando-logos" }],
  "d1_databases": [
    { "binding": "ACCOUNTS", "database_name": "politicando-accounts", "database_id": "38d4e3b4-a8a3-437d-8ef0-a06cc074d051", "migrations_dir": "migrations" }
  ]
}
