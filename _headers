# Security headers for the static assets served by Cloudflare Workers (wrangler.jsonc: assets); the answers of the API carry theirs from worker.js.
# The game runs no inline script and loads nothing from another site, apart from the pictures (https:) of logos that someone linked on purpose. Style attributes are the one inline thing allowed.
# The same policy, without frame-ancestors (which a <meta> cannot carry), is in the <meta http-equiv> of every page, so it also holds on GitHub Pages and in the installed app (Capacitor), which receive no headers.
# `npm run check:security` keeps the two in step.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://palazzo-2026-site.bianchimatteo657.workers.dev http://127.0.0.1:8791 http://localhost:8791; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
# The service worker must always be checked for a new version.
/sw.js
  Cache-Control: no-cache
